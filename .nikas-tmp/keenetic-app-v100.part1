const K100_VERSION = "1.0.0";
const K100_CORE = customElements.get("keenetic-hero-panel");
const K100_ALLOWED = [
  ["/dashboard-house-v11", "/dashboard-house-v11/home"],
  ["/dashboard-actions", "/dashboard-actions/home"],
  ["/dashboard-infrastructure", "/dashboard-infrastructure/overview"],
];
const K100_TABS = [
  ["overview", "mdi:view-dashboard-outline", "Обзор"],
  ["wan", "mdi:web", "Каналы"],
  ["failover", "mdi:swap-horizontal-bold", "Failover"],
  ["traffic", "mdi:chart-timeline-variant", "Трафик"],
  ["diagnostics", "mdi:stethoscope", "Диагн."],
];
const K100_MIN_SCALE = 0.75;
const K100_MAX_SCALE = 2;
const K100_SNAP_MIN = 0.97;
const K100_SNAP_MAX = 1.03;
const K100_DOUBLE_TAP_MS = 360;
const K100_TAP_MS = 280;
const K100_TAP_MOVE = 14;
const K100_PAN_START = 6;
const K100_CLICK_GUARD_MS = 380;
const K100_HANDOFF_MAX_AGE_MS = 30_000;

const k100ClampScale = (value) =>
  Math.min(K100_MAX_SCALE, Math.max(K100_MIN_SCALE, Number(value) || 1));
const k100Distance = (a, b) => Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
const k100PointDistance = (a, b) => Math.hypot(b.x - a.x, b.y - a.y);
const k100PageMidpoint = (a, b) => ({
  x: (a.clientX + b.clientX) / 2,
  y: (a.clientY + b.clientY) / 2,
});

function k100Esc(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function k100SafeRoute(value) {
  if (typeof value !== "string") return null;
  const candidate = value.trim();
  if (!candidate || candidate.startsWith("//")) return null;
  try {
    const url = new URL(candidate, window.location.origin);
    if (url.origin !== window.location.origin) return null;
    const pathname = url.pathname.replace(/\/+$/, "") || "/";
    for (const [root, canonical] of K100_ALLOWED) {
      if (pathname === root || pathname.startsWith(`${root}/`)) return canonical;
    }
  } catch (_error) {
    return null;
  }
  return null;
}

function k100ConsumeSourceRoute() {
  let once = null;
  let onceAt = null;
  try {
    once = sessionStorage.getItem("nikas.specialized.source_route.v1");
    onceAt = sessionStorage.getItem("nikas.specialized.source_route_at.v1");
  } catch (_error) {
    return null;
  } finally {
    try {
      sessionStorage.removeItem("nikas.specialized.source_route.v1");
      sessionStorage.removeItem("nikas.specialized.source_route_at.v1");
    } catch (_error) {
      // The one-shot hand-off is optional acceleration; safe fallback remains available.
    }
  }
  const paired = once!==null&&onceAt!==null;
  if (!paired) return null;
  const timestamp = Number(onceAt);
  const handedOffAge = Date.now() - timestamp;
  const fresh =
    Number.isFinite(timestamp) &&
    Number.isFinite(handedOffAge) &&
    handedOffAge>=0 &&
    handedOffAge<=K100_HANDOFF_MAX_AGE_MS;
  if (!fresh) return null;
  return k100SafeRoute(once);
}

function k100Return(panel) {
  const handedOff = k100ConsumeSourceRoute();
  const params = new URLSearchParams(location.search);
  for (const key of ["return_to","from"]) {
    const explicit = k100SafeRoute(params.get(key));
    if (explicit) return explicit;
  }
  if (handedOff) return handedOff;

  let saved = null;
  try {
    saved = k100SafeRoute(localStorage.getItem("nikas.keenetic.return_route.v1"));
  } catch (_error) {
    saved = null;
  }
  if (saved) return saved;

  const referrer = k100SafeRoute(document.referrer);
  if (referrer) return referrer;

  const configured = k100SafeRoute(panel?.config?.parent_route);
  if (configured) return configured;

  return "/dashboard-infrastructure/overview";
}

function k100Navigate(route) {
  window.history.pushState(null, "", route);
  window.dispatchEvent(new Event("location-changed"));
}

function k100Midpoint(a, b, viewport) {
  const rect = viewport.getBoundingClientRect();
  return {
    x: (a.clientX + b.clientX) / 2 - rect.left,
    y: (a.clientY + b.clientY) / 2 - rect.top,
  };
}

function k100DeepElement(root, x, y) {
  let element = root?.elementFromPoint?.(x, y) || document.elementFromPoint(x, y);
  const seen = new Set();
  while (element?.shadowRoot?.elementFromPoint && !seen.has(element)) {
    seen.add(element);
    const inner = element.shadowRoot.elementFromPoint(x, y);
    if (!inner || inner === element) break;
    element = inner;
  }
  return element;
}

function k100CancelEntityHold(target) {
  const entity = target?.closest?.("[data-entity]") || target;
  if (!entity?.dispatchEvent) return;
  const event =
    typeof PointerEvent === "function"
      ? new PointerEvent("pointercancel", { bubbles: true, composed: true })
      : new Event("pointercancel", { bubbles: true, composed: true });
  entity.dispatchEvent(event);
}

function k100Indicator(panel) {
  const telemetry = panel._telemetry?.() || {};
  const configured = panel._bootstrap?.telemetry || {};
  const channel = String(
    configured.active_data_channel || configured.data_channel || "local",
  ).toLowerCase();
  const connectionAvailable = configured.connection_available;
  let connection = { label: "Локально", tone: "ok" };

  if (connectionAvailable === false) {
    connection = { label: "Нет связи", tone: "bad" };
  } else if (channel === "cloud") {
    connection = { label: "Облако", tone: "ok" };
  } else if (channel === "reserve" || channel === "backup") {
    connection = { label: "Резерв", tone: "warn" };
  } else if (!["local", "lan", "api", "rci", "snmp", "mqtt"].includes(channel)) {
    connection = { label: "Нет данных", tone: "unknown" };
  }

  const age = Number(telemetry.age);
  const hasAge =
    telemetry.age !== null &&
    telemetry.age !== undefined &&
    Number.isFinite(age);
  const failedPoll = configured.last_update_success === false;
  const scanInterval = Math.max(1, Number(configured.scan_interval_seconds || 30));
  const staleAfter = scanInterval * 3;
  let freshness = { label: "Нет данных", tone: "unknown" };

  if (hasAge && (failedPoll || age > staleAfter)) {
    freshness = { label: "Данные устарели", tone: "warn" };
  } else if (hasAge) {
    freshness = { label: "Данные актуальны", tone: "neutral" };
  }

  return { connection, freshness };
}

function k100Reserve(panel, active) {
  const role = active === "ethernet" ? "lte" : active === "lte" ? "ethernet" : null;
  const connection = role ? panel._connection(`${role}_connected`) : { state: "unknown" };
  const name = role === "lte" ? "4G LTE" : role === "ethernet" ? "Ethernet" : "Резерв";
  if (connection.state === "up") {
    return [
      "ok",
      "mdi:check-circle",
      active === "lte" ? "Работа через резерв" : "Резерв готов",
      active === "lte"
        ? "Основной Ethernet недоступен."
        : `${name} подключён и готов к работе.`,
    ];
  }
  if (connection.state === "down") {
    return ["bad", "mdi:alert-circle-outline", "Резерв недоступен", `${name} сейчас недоступен.`];
  }
  return [
    "unknown",
    "mdi:help-circle-outline",
    "Нет данных о резерве",
    "Готовность резервного канала не подтверждена.",
  ];
}

function k100Metric(panel, role, icon, label, value, wide = "") {
  const entityId = role ? panel._entityId?.(role) : null;
  return `<div class="k100-metric ${wide}"${
    entityId ? ` data-entity="${k100Esc(entityId)}" tabindex="0"` : ""
  }><ha-icon icon="${icon}"></ha-icon><div><span>${k100Esc(label)}</span><strong>${k100Esc(
    value,
  )}</strong></div></div>`;
}

function k100Overview(panel) {
  const internet = panel._internet();
  const telemetry = panel._telemetry();
  const indicator = k100Indicator(panel);
  const active = panel._activeWan();
  const activeName =
    active === "ethernet" ? "Ethernet" : active === "lte" ? "4G LTE" : "Канал не определён";
  const heroTitle =
    internet.online === true
      ? "Интернет работает"
      : internet.online === false
        ? "Нет подключения"
        : "Состояние неизвестно";
  const reserve = k100Reserve(panel, active);
  const ethernet = panel._connection("ethernet_connected");
  const lte = panel._connection("lte_connected");
  const channelState = (role, connection) =>
    active === role
      ? "active"
      : connection.state === "up"
        ? "standby"
        : connection.state === "down"
          ? "down"
          : "unknown";
  const ping = active === "lte" ? "lte_ping" : active === "ethernet" ? "ethernet_ping" : null;
  const loss =
    active === "lte" ? "lte_packet_loss" : active === "ethernet" ? "ethernet_packet_loss" : null;
  const rx = active === "lte" ? "lte_rx_mbps" : active === "ethernet" ? "ethernet_rx_mbps" : null;
  const tx = active === "lte" ? "lte_tx_mbps" : active === "ethernet" ? "ethernet_tx_mbps" : null;
  const ip = active === "lte" ? "lte_wan_ipv4" : active === "ethernet" ? "ethernet_wan_ipv4" : null;
  const uptime =
    active === "lte" ? "lte_interface_uptime" : active === "ethernet" ? "ethernet_interface_uptime" : null;
  const link = active === "lte" ? "lte_rsrp" : active === "ethernet" ? "ethernet_link_speed" : null;
  const linkLabel = active === "lte" ? "Сигнал" : "Link";
  const linkValue =
    active === "lte"
      ? panel._display("lte_rsrp", "—")
      : active === "ethernet"
        ? panel._display("ethernet_link_speed", "—")
        : "—";

  return `<section class="k100-overview">
    <article class="k100-hero">
      <div class="k100-copy"><h1>${k100Esc(heroTitle)}</h1><p>${
        active ? `Основной канал · ${k100Esc(activeName)}` : "Канал не определён"
      }</p></div>
      <div class="k100-indicator ${indicator.connection.tone}" aria-live="polite" aria-label="${k100Esc(
        `${indicator.connection.label}. ${indicator.freshness.label}`,
      )}"><strong><i></i>${k100Esc(indicator.connection.label)}</strong><span class="fresh ${
        indicator.freshness.tone
      }">${k100Esc(indicator.freshness.label)}</span></div>
      <svg class="k100-lines" viewBox="0 0 1000 620" preserveAspectRatio="none"><path class="lte ${channelState(
        "lte",
        lte,
      )}" d="M500 210 L500 406"/><path class="eth ${channelState(
        "ethernet",
        ethernet,
      )}" d="M245 370 L430 370"/><path class="lan active" d="M570 370 L755 370"/></svg>
      <div class="k100-channel k100-lte ${channelState(
        "lte",
        lte,
      )}"><ha-icon icon="mdi:radio-tower"></ha-icon><div><strong>4G LTE</strong><span>${
        active === "lte" ? "Активный канал" : lte.state === "up" ? "Резервный канал" : "Нет данных"
      }</span></div></div>
      <div class="k100-channel k100-eth ${channelState(
        "ethernet",
        ethernet,
      )}"><ha-icon icon="mdi:ethernet"></ha-icon><div><strong>Кабель</strong><span>${
        active === "ethernet"
          ? "Основной канал"
          : ethernet.state === "up"
            ? "Резервный канал"
            : "Нет данных"
      }</span></div></div>
      <div class="k100-channel k100-lan active"><ha-icon icon="mdi:lan"></ha-icon><div><strong>LAN</strong><span>Локальная сеть</span></div></div>
      <img class="k100-router" src="/keenetic_hero_4g_static/assets/keenetic-hero-router-v086.webp?v=1.0.0" alt="Keenetic Hero 4G+">
    </article>
    <div class="k100-reserve ${reserve[0]}"><ha-icon icon="${reserve[1]}"></ha-icon><div><strong>${
      reserve[2]
    }</strong><span>${reserve[3]}</span></div></div>
    <article class="k100-active-card">
      <div class="k100-active-head"><ha-icon icon="${
        active === "lte"
          ? "mdi:radio-tower"
          : active === "ethernet"
            ? "mdi:ethernet"
            : "mdi:lan-disconnect"
      }"></ha-icon><strong>${k100Esc(activeName)}</strong><span class="${
        active ? "ok" : "unknown"
      }"><i></i>${active ? "Активен" : "Нет данных"}</span><button type="button" data-view="wan" aria-label="Открыть каналы"><ha-icon icon="mdi:chevron-right"></ha-icon></button></div>
      <div class="k100-grid">
        ${k100Metric(panel, ping, "mdi:earth", "Ping", active ? panel._display(ping, "—") : "—")}
        ${k100Metric(
          panel,
          loss,
          "mdi:shield-check-outline",
          "Потеря пакетов",
          active ? panel._display(loss, "—") : "—",
        )}
        ${k100Metric(
          panel,
          null,
          "mdi:timer-outline",
          "Телеметрия",
          telemetry.age === null ? "—" : `${Math.round(telemetry.age)} с`,
        )}
        ${k100Metric(panel, link, "mdi:link-variant", linkLabel, linkValue)}
        ${k100Metric(panel, rx, "mdi:download-network-outline", "RX", active ? panel._display(rx, "—") : "—")}
        ${k100Metric(panel, tx, "mdi:upload-network-outline", "TX", active ? panel._display(tx, "—") : "—")}
        ${k100Metric(
          panel,
          ip,
          "mdi:ip-network-outline",
          "WAN IP",
          active ? panel._display(ip, "—") : "—",
          "wide",
        )}
        ${k100Metric(
          panel,
          uptime,
          "mdi:clock-outline",
          "Uptime",
          active ? panel._display(uptime, "—") : "—",
        )}
      </div>
    </article>
    <div class="k100-alert ${telemetry.trusted ? "hidden" : telemetry.stale ? "warn" : "bad"}"><ha-icon icon="mdi:alert-circle-outline"></ha-icon><div><strong>${k100Esc(
      telemetry.label,
    )}</strong><span>${k100Esc(telemetry.detail)}</span></div></div>
  </section>`;
}

function k100InstallCore() {
  if (!K100_CORE || K100_CORE.prototype.__k100) return;
  K100_CORE.prototype.__k100 = true;
  K100_CORE.prototype._renderOverview = function () {
    return k100Overview(this);
  };
  const oldMount = K100_CORE.prototype._mountStableDomV075;
  if (oldMount) {
    K100_CORE.prototype._mountStableDomV075 = function (...args) {
      const result = oldMount.apply(this, args);
      k100InstallStyles(this.shadowRoot);
      return result;
    };
  }
  const oldRender = K100_CORE.prototype._render;
  K100_CORE.prototype._render = function (...args) {
    const result = oldRender.apply(this, args);
    k100InstallStyles(this.shadowRoot);
    return result;
  };
}

function k100InstallStyles(root) {
  if (!root || root.querySelector("style[data-k100]")) return;
  const style = document.createElement("style");
  style.dataset.k100 = "1";
  style.textContent = `
.k100-overview{display:grid;gap:10px;padding:10px 10px 18px;min-height:100%}
.k100-hero{position:relative;height:430px;border:1px solid var(--divider-color);border-radius:24px;overflow:hidden;background:url('/keenetic_hero_4g_static/assets/keenetic-hero-room-v064.webp?v=1.0.0') center/cover no-repeat;box-shadow:0 8px 26px rgba(23,45,76,.08)}
.k100-copy{position:absolute;z-index:8;left:16px;top:8px;max-width:48%}
.k100-copy h1{margin:0 0 3px;font-size:20px;line-height:1.04}
.k100-copy p{margin:0;font-size:12px;font-weight:650;color:var(--secondary-text-color)}
.k100-indicator{position:absolute;z-index:9;right:14px;top:14px;width:174px;padding:11px 14px;border:1px solid;border-radius:18px}
.k100-indicator strong,.k100-indicator span{display:block}
.k100-indicator strong{font-size:16px;font-weight:700}
.k100-indicator span{margin-top:6px;font-size:13px;font-weight:600;color:var(--secondary-text-color)}
.k100-indicator i,.k100-active-head i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:8px;background:currentColor}
.k100-indicator.ok{color:#2fb878;border-color:#9ce4c5;background:rgba(232,249,241,.94)}
.k100-indicator.warn{color:#c58419;border-color:#efcf95;background:rgba(255,248,235,.94)}
.k100-indicator.bad{color:#d95d63;border-color:#efb8ba;background:rgba(255,238,239,.94)}
.k100-indicator.unknown{color:#69757f;border-color:#cdd3d8;background:rgba(248,249,250,.94)}
.k100-indicator .fresh.neutral{color:var(--secondary-text-color)}
.k100-indicator .fresh.warn{color:#c58419}
.k100-indicator .fresh.unknown{color:#69757f}
.k100-lines{position:absolute;inset:0;z-index:3;width:100%;height:100%}
.k100-lines path{fill:none;stroke:#9aa3ab;stroke-width:7;stroke-linecap:round;stroke-dasharray:8 13}
.k100-lines path.active{stroke:#2fbd7c;stroke-dasharray:none}
.k100-lines path.standby{stroke:#16a4db}
.k100-lines path.down{stroke:#dc6267;opacity:.65}
.k100-router{position:absolute;z-index:6;left:50%;top:64.5%;transform:translate(-50%,-50%);width:40%;max-width:290px;filter:drop-shadow(0 10px 9px rgba(65,45,30,.18));pointer-events:none}
.k100-channel{position:absolute;z-index:8;display:flex;align-items:center;gap:9px;padding:10px 12px;border-radius:18px;background:rgba(255,255,255,.94);box-shadow:0 8px 20px rgba(23,45,76,.09);min-width:145px}
.k100-channel ha-icon{--mdc-icon-size:28px}
.k100-channel strong,.k100-channel span{display:block}
.k100-channel strong{font-size:15px}
.k100-channel span{font-size:12px;margin-top:3px;color:var(--secondary-text-color)}
.k100-channel.active{color:#2fb878}
.k100-channel.standby{color:#139ed1}
.k100-channel.down{color:#d95d63}
.k100-channel.unknown{color:#7e8993}
.k100-lte{left:50%;top:28.5%;transform:translate(-50%,-50%)}
.k100-eth{left:3%;top:57.5%}
.k100-lan{right:3%;top:57.5%}
.k100-reserve,.k100-alert{display:flex;align-items:center;gap:12px;padding:12px 16px;border:1px solid;border-radius:20px}
.k100-reserve ha-icon,.k100-alert ha-icon{--mdc-icon-size:30px}
.k100-reserve strong,.k100-reserve span,.k100-alert strong,.k100-alert span{display:block}
.k100-reserve strong,.k100-alert strong{font-size:16px}
