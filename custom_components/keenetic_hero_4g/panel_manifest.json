{
  "schema_version": 2,
  "panel": "keenetic",
  "panel_version": "1.0.7",
  "route": "/dashboard-keenetic",
  "entry_module": "keenetic-panel-bundle.js",
  "web_component": "keenetic-hero-app-panel-v100",
  "ha_menu_event": {
    "type": "hass-toggle-menu",
    "bubbles": true,
    "composed": true
  },
  "zoom_policy": {
    "standard": "2.2",
    "engine": "native_vertical_at_100_transform_pan_above_100",
    "min_percent": 75,
    "max_percent": 200,
    "permanent_controls": false,
    "reset_gesture": "two_finger_double_tap",
    "snap_to_100_percent": [
      97,
      103
    ],
    "native_vertical_scroll_at_100_percent": true,
    "horizontal_scroll_at_100_percent": false,
    "pan_only_above_100_percent": true,
    "pan_axes": "overflow_only"
  },
  "shell_policy": {
    "standard": "2.1",
    "header_center_action": "return_to_source_base_panel",
    "source_route_handoff_key": "nikas.specialized.source_route.v1",
    "browser_history_back_allowed": false,
    "host_position": "home_assistant_panel_host_boundary",
    "height_locked": true,
    "header_body_px": 60,
    "bottom_navigation_body_px": 64,
    "bottom_navigation_icon_px": 26,
    "content_max_width_px": 1280,
    "content_gutter_owner": "specialized_panel_shell",
    "nested_page_padding": false,
    "overview_scroll_at_primary_viewport": false,
    "work_viewport_vertical_scroll": true,
    "header_and_navigation_outside_viewport": true,
    "scroll_boundary_guard": "capture_non_passive_host_boundary_guard",
    "vendored_source_kit": "frontend/nikas-specialized-shell.js"
  },
  "update_policy": {
    "dom_mount": "once",
    "hass_updates": "requestAnimationFrame_point_patch",
    "persistent_view_containers": true,
    "full_dom_replacement_after_mount": false,
    "persistent_bottom_navigation": true,
    "connection_indicator_category_only": true
  },
  "static_route": "/keenetic_hero_4g_static/",
  "assets_directory": "frontend/assets",
  "assets": [
    {
      "path": "frontend/assets/keenetic-hero-room-v064.webp",
      "url": "/keenetic_hero_4g_static/assets/keenetic-hero-room-v064.webp?v=1.0.7",
      "role": "overview_hero_background",
      "format": "webp"
    },
    {
      "path": "frontend/assets/keenetic-hero-router-v086.webp",
      "url": "/keenetic_hero_4g_static/assets/keenetic-hero-router-v086.webp?v=1.0.7",
      "role": "overview_router_layer",
      "format": "webp"
    }
  ]
}
