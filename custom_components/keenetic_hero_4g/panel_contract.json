{
  "panel": {
    "id": "keenetic",
    "title": "Keenetic",
    "path": "/dashboard-keenetic",
    "icon": "mdi:router-network",
    "owner": "ha-keenetic-hero-4g",
    "parent_route": "/dashboard-infrastructure/overview",
    "expose_in_generated_ui": true,
    "preferred_view": "overview",
    "version": "0.2.1"
  },
  "app_shell": {
    "standard": "Home Assistant NikaS specialized panel",
    "version": "1.1",
    "header": {
      "back": {
        "icon": "mdi:arrow-left",
        "label": "Назад",
        "navigate": "/dashboard-infrastructure/overview",
        "use_browser_history": false,
        "min_touch_target_px": 44
      },
      "title": "Keenetic Hero 4G+",
      "actions": ["refresh"]
    },
    "bottom_navigation": {
      "fixed": true,
      "edge_attached": true,
      "full_width_mobile": true,
      "floating": false,
      "safe_area": true,
      "max_primary_items": 5,
      "items": [
        "overview",
        "wan",
        "failover",
        "traffic",
        "diagnostics"
      ]
    },
    "secondary_views": ["system"]
  },
  "generated_ui": {
    "mode": "compact_summary",
    "deep_link": "/dashboard-keenetic",
    "roles": {
      "internet": "internet_connectivity",
      "active_wan": "active_wan",
      "lte_reserve": "lte_connected",
      "switches_today": "wan_switches_today"
    },
    "do_not_duplicate": [
      "wan_lte_diagnostics",
      "traffic_history",
      "failover_details",
      "lte_radio_diagnostics",
      "router_system_details"
    ]
  },
  "primary_views": [
    "overview",
    "wan",
    "failover",
    "traffic",
    "diagnostics"
  ],
  "secondary_views": ["system"]
}
