{
  "panel": {
    "id": "keenetic",
    "title": "Keenetic",
    "path": "/dashboard-keenetic",
    "icon": "mdi:router-network",
    "owner": "ha-keenetic-hero-4g",
    "parent_route": "/dashboard-infrastructure/overview",
    "expose_in_generated_ui": true,
    "preferred_view": "overview",
    "version": "0.4.4"
  },
  "app_shell": {
    "standard": "Home Assistant NikaS specialized panel",
    "version": "1.2",
    "header": {
      "menu": {"icon": "mdi:menu", "action": "hass-toggle-menu", "min_touch_target_px": 44},
      "title": "Keenetic Hero 4G+",
      "title_alignment": "viewport_center",
      "show_brand_icon": false,
      "actions": ["refresh"]
    },
    "bottom_navigation": {
      "fixed": true,
      "edge_attached": true,
      "full_width_mobile": true,
      "floating": false,
      "safe_area": true,
      "outside_scroll_region": true,
      "overlaps_content": false,
      "max_primary_items": 5,
      "standard_geometry": "specialized_panel_compact",
      "equal_width_items": true,
      "active_state": "compact_tint",
      "active_full_cell_fill": false,
      "items": ["overview", "wan", "failover", "traffic", "diagnostics"]
    },
    "secondary_views": ["system"],
    "bootstrap": {
      "registration_snapshot_fallback": true,
      "cached_role_mapping": true,
      "live_values_from_hass_states": true,
      "websocket_refresh": "background_only",
      "websocket_timeout_seconds": 5,
      "structural_polling_seconds": 0,
      "blank_screen_on_bootstrap_timeout": false,
      "keep_cached_mapping_on_timeout": true,
      "fallback_excludes_host_and_unique_id": true,
      "replay_pre_upgrade_properties": true
    }
  },
  "frontend_delivery": {
    "mode": "versioned_runtime_selector",
    "module": "keenetic-app-v044.js",
    "web_component": "keenetic-hero-app-panel-v044",
    "includes_styles": true,
    "cache_busting": "physical_module_version_plus_query_panel_version",
    "runtime_previous_version_imports": true
  },
  "runtime_guards": {
    "overview_cross_module_time_helper": true,
    "failover_recorder_history_enabled": false,
    "failover_history_timeout_seconds": 0,
    "bootstrap_cache_storage": "localStorage",
    "bootstrap_timeout_seconds": 5,
    "bootstrap_polling_enabled": false,
    "infinite_loading_allowed": false
  },
  "view_patterns": {
    "overview": {
      "preserve_network_topology": true,
      "active_path_only": true,
      "inactive_grey_branches": false,
      "reserve_channel_separate": true,
      "channel_selector": "contextual_segmented",
      "items": ["ethernet", "lte"],
      "labels": ["Провод", "LTE"],
      "default_selected_from_role": "active_wan",
      "active_branch_indicator": true,
      "single_channel_detail_visible": true,
      "unknown_active_wan_has_no_fabricated_default": true,
      "device_selector": false,
      "device_control": false
    },
    "wan": {
      "selector": "contextual_segmented",
      "items": ["ethernet", "lte"],
      "labels": ["Провод", "LTE"],
      "single_detail_visible": true,
      "device_selector": false
    },
    "traffic": {
      "mode": "stabilization_current_only",
      "recorder_history_enabled": false,
      "period_selector_visible": false,
      "periods_temporarily_removed": ["24h", "7d", "30d"],
      "show_current_rates": true,
      "show_accumulated_counters": true,
      "restore_history_in_separate_change": true
    }
  },
  "generated_ui": {
    "mode": "compact_summary",
    "deep_link": "/dashboard-keenetic",
    "roles": {
      "internet": "internet_connectivity",
      "active_wan": "active_wan",
      "lte_reserve": "lte_connected",
      "switches_today": "wan_switches_today"
    },
    "do_not_duplicate": ["wan_lte_diagnostics", "traffic_history", "failover_details", "lte_radio_diagnostics", "router_system_details"]
  },
  "primary_views": ["overview", "wan", "failover", "traffic", "diagnostics"],
  "secondary_views": ["system"]
}
