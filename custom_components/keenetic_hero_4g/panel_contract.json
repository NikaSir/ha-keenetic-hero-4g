{
  "panel": {
    "id": "keenetic",
    "title": "Keenetic",
    "path": "/dashboard-keenetic",
    "icon": "mdi:router-network",
    "owner": "ha-keenetic-hero-4g",
    "parent_route": "/dashboard-infrastructure/overview",
    "expose_in_generated_ui": true,
    "preferred_view": "overview",
    "version": "0.2.9"
  },
  "frontend_release": {
    "production_bundle": "/keenetic_hero_4g_static/keenetic-panel.bundle.js",
    "module_url_cache_busting": "query_version",
    "self_contained": true,
    "runtime_previous_version_imports": false,
    "runtime_external_panel_css": false,
    "source_entry": "frontend/keenetic-app-v029.js",
    "generated_by": "scripts/build_frontend_bundle.py"
  },
  "app_shell": {
    "standard": "Home Assistant NikaS specialized panel",
    "version": "1.2",
    "header": {
      "back": {
        "icon": "mdi:arrow-left",
        "label": "Назад",
        "navigate": "/dashboard-infrastructure/overview",
        "use_browser_history": false,
        "min_touch_target_px": 44
      },
      "title": "Keenetic Hero 4G+",
      "title_alignment": "viewport_center",
      "show_brand_icon": false,
      "actions": ["refresh"]
    },
    "bottom_navigation": {
      "fixed": true,
      "edge_attached": true,
      "full_width_mobile": true,
      "floating": false,
      "safe_area": true,
      "outside_scroll_region": true,
      "overlaps_content": false,
      "max_primary_items": 5,
      "items": [
        "overview",
        "wan",
        "failover",
        "traffic",
        "diagnostics"
      ]
    },
    "secondary_views": ["system"],
    "bootstrap": {
      "registration_snapshot_fallback": true,
      "websocket_refresh": true,
      "websocket_timeout_seconds": 5,
      "blank_screen_on_bootstrap_timeout": false,
      "fallback_excludes_host_and_unique_id": true
    }
  },
  "view_patterns": {
    "overview": {
      "preserve_network_topology": true,
      "channel_selector": "contextual_segmented",
      "items": ["ethernet", "lte"],
      "labels": ["Провод", "LTE"],
      "default_selected_from_role": "active_wan",
      "active_branch_indicator": true,
      "single_channel_detail_visible": true,
      "unknown_active_wan_has_no_fabricated_default": true,
      "device_selector": false,
      "device_control": false,
      "tap_action": "show selected channel detail in Overview"
    },
    "wan": {
      "selector": "contextual_segmented",
      "items": ["ethernet", "lte"],
      "labels": ["Провод", "LTE"],
      "single_detail_visible": true,
      "device_selector": false,
      "reference_pattern": "Stark-style segmented context selector"
    },
    "traffic": {
      "periods": ["24h", "7d", "30d"],
      "refresh_on_each_selection": true,
      "stale_period_cache_must_not_suppress_reload": true,
      "late_response_must_not_replace_current_period_state": true,
      "finite_ui_timeout_seconds": {
        "24h": 6,
        "7d": 8,
        "30d": 10
      },
      "period_switching_remains_available_while_previous_request_is_pending": true
    }
  },
  "generated_ui": {
    "mode": "compact_summary",
    "deep_link": "/dashboard-keenetic",
    "roles": {
      "internet": "internet_connectivity",
      "active_wan": "active_wan",
      "lte_reserve": "lte_connected",
      "switches_today": "wan_switches_today"
    },
    "do_not_duplicate": [
      "wan_lte_diagnostics",
      "traffic_history",
      "failover_details",
      "lte_radio_diagnostics",
      "router_system_details"
    ]
  },
  "primary_views": [
    "overview",
    "wan",
    "failover",
    "traffic",
    "diagnostics"
  ],
  "secondary_views": ["system"]
}
