{
  "panel": {
    "id": "keenetic",
    "title": "Keenetic",
    "path": "/dashboard-keenetic",
    "icon": "mdi:router-network",
    "owner": "ha-keenetic-hero-4g",
    "parent_route": "/dashboard-infrastructure/overview",
    "expose_in_generated_ui": true,
    "preferred_view": "overview",
    "version": "0.7.0"
  },
  "app_shell": {
    "standard": "Home Assistant NikaS specialized panel",
    "version": "1.3",
    "standards": {
      "shell": "1.3",
      "zoom": "1.3",
      "integration_ui": "1.4",
      "frontend_delivery": "1.1"
    },
    "header": {
      "menu": {
        "icon": "mdi:menu",
        "action": "hass-toggle-menu",
        "event_bubbles": true,
        "event_composed": true,
        "min_touch_target_px": 44
      },
      "title": "Keenetic Hero 4G+",
      "title_alignment": "viewport_center",
      "symmetric_side_slots_px": 64,
      "compact_side_slots_px_narrow": 52,
      "show_brand_icon": false,
      "actions": ["refresh"],
      "safe_area_top": true
    },
    "bottom_navigation": {
      "fixed": true,
      "edge_attached": true,
      "full_width_mobile": true,
      "floating": false,
      "safe_area": true,
      "outside_scroll_region": true,
      "overlaps_content": false,
      "equal_width_items": true,
      "standard_geometry": "specialized_panel_compact",
      "active_state": "compact_tint",
      "active_full_cell_fill": false,
      "active_max_width_px": 112,
      "min_touch_target_px": 44,
      "preferred_button_height_px": 54,
      "max_primary_items": 5,
      "items": ["overview", "wan", "failover", "traffic", "diagnostics"]
    },
    "viewport_fit": {
      "primary_css_width_px": 430,
      "secondary_check_css_width_px": 390,
      "horizontal_scroll_allowed": false,
      "content_overflow_x_hidden": true,
      "header_title_must_remain_geometrically_centered": true,
      "tab_labels_must_fit_or_ellipsis_inside_equal_tracks": true,
      "safe_area_owner": "specialized_panel_shell",
      "safe_area_applied_once": true
    },
    "content_zoom": {
      "enabled": true,
      "scope": "central_work_area_only",
      "engine": "transform_owned_canvas",
      "transform": "translate3d_pan_then_scale",
      "single_viewport_per_panel_instance": true,
      "gesture": "two_finger_pinch",
      "gesture_origin": "touch_midpoint",
      "header_fixed": true,
      "bottom_navigation_fixed": true,
      "permanent_controls": false,
      "controls": [],
      "min_percent": 75,
      "max_percent": 200,
      "pan_when_zoomed": true,
      "pan_at_100_percent": true,
      "native_overflow_position": false,
      "reset_gesture": "two_finger_double_tap",
      "reset_target": "100_percent_origin",
      "snap_to_100_percent": {
        "min_percent": 97,
        "max_percent": 103
      },
      "reset_feedback": "Масштаб 100%",
      "gesture_click_guard_ms": 700,
      "cancel_entity_hold_on_gesture": true,
      "responsive_layout_before_zoom": true,
      "idempotent_reconciliation": true,
      "persistence": "localStorage",
      "persistence_scope": "panel_client"
    },
    "secondary_views": ["system"],
    "bootstrap": {
      "registration_snapshot_fallback": true,
      "cached_role_mapping": true,
      "cache_privacy_safe": true,
      "cache_excludes_host_and_unique_id": true,
      "live_values_from_hass_states": true,
      "websocket_refresh": "background_only",
      "websocket_timeout_seconds": 5,
      "structural_polling_seconds": 0,
      "blank_screen_on_bootstrap_timeout": false,
      "keep_cached_mapping_on_timeout": true,
      "fallback_excludes_host_and_unique_id": true,
      "replay_pre_upgrade_properties": true
    }
  },
  "frontend_delivery": {
    "mode": "self_contained_bundle",
    "module": "keenetic-panel-bundle.js",
    "web_component": "keenetic-hero-app-panel-v070",
    "includes_styles": true,
    "includes_hero_artwork": true,
    "assets_directory": "frontend/assets",
    "assets_manifest": "panel_manifest.json",
    "hero_artwork_format": "layered_local_assets",
    "hero_artwork_path": "/keenetic_hero_4g_static/assets/keenetic-hero-room-v064.webp",
    "hero_layers": {
      "room": "/keenetic_hero_4g_static/assets/keenetic-hero-room-v064.webp",
      "router": "/keenetic_hero_4g_static/assets/keenetic-hero-router-v063.webp",
      "connections": "dynamic_svg_dom",
      "telemetry": "live_hass_html"
    },
    "external_image_dependency": false,
    "inline_base64_assets_allowed": false,
    "cache_busting": "query_panel_version",
    "runtime_previous_version_imports": false,
    "runtime_external_panel_css": false
  },
  "runtime_guards": {
    "overview_cross_module_time_helper": true,
    "failover_recorder_history_enabled": false,
    "failover_history_timeout_seconds": 0,
    "bootstrap_cache_storage": "localStorage",
    "bootstrap_timeout_seconds": 5,
    "bootstrap_polling_enabled": false,
    "infinite_loading_allowed": false
  },
  "view_patterns": {
    "overview": {
      "hero_style": "layered_room_router",
      "hero_background": "local_static_webp",
      "hero_router_layer": "local_static_webp",
      "connection_layer": "dynamic_svg",
      "hero_mobile_min_height_px": 438,
      "dynamic_overlays_from_hass_states": true,
      "preserve_network_topology": true,
      "active_path_only": true,
      "inactive_grey_branches": false,
      "reserve_channel_separate": true,
      "reserve_badge_separate": true,
      "topology": {
        "upper_left": "lte_reserve",
        "lower_left": "ethernet_cable",
        "right": "lan",
        "center_internet_cloud": false,
        "outlet_artwork": false,
        "cable_label": "Кабель",
        "lan_label": "LAN",
        "separate_path_segments": true,
        "router_blocks_path_visual": true
      },
      "composition": {
        "room_asset": "keenetic-hero-room-v064.webp",
        "router_asset": "keenetic-hero-router-v063.webp",
        "router_scale_mobile_percent": 53,
        "router_vertical_percent": 52.5,
        "lte_card_top_percent": 25.5,
        "cable_card_top_percent": 44,
        "lan_card_top_percent": 44,
        "status_primary_label_ethernet": "Ethernet",
        "active_ethernet_path_style": "solid_green",
        "reserve_lte_path_style": "animated_blue_dots"
      },
      "kpi_overlay": ["ping", "packet_loss", "telemetry_age"],
      "overview_sections": ["hero", "channels"],
      "items": ["ethernet", "lte"],
      "labels": ["Кабель", "LTE"],
      "default_selected_from_role": "active_wan",
      "active_branch_indicator": true,
      "single_channel_detail_visible": true,
      "unknown_active_wan_has_no_fabricated_default": true,
      "mobile_channel_grid": "3x2",
      "device_selector": false,
      "device_control": false
    },
    "wan": {
      "selector": "contextual_segmented",
      "items": ["ethernet", "lte"],
      "labels": ["Кабель", "LTE"],
      "single_detail_visible": true,
      "device_selector": false
    },
    "traffic": {
      "mode": "stabilization_current_only",
      "recorder_history_enabled": false,
      "period_selector_visible": false,
      "periods_temporarily_removed": ["24h", "7d", "30d"],
      "show_current_rates": true,
      "show_accumulated_counters": true,
      "restore_history_in_separate_change": true
    }
  },
  "generated_ui": {
    "mode": "compact_summary",
    "deep_link": "/dashboard-keenetic",
    "roles": {
      "internet": "internet_connectivity",
      "active_wan": "active_wan",
      "lte_reserve": "lte_connected",
      "switches_today": "wan_switches_today"
    },
    "do_not_duplicate": ["wan_lte_diagnostics", "traffic_history", "failover_details", "lte_radio_diagnostics", "router_system_details"]
  },
  "primary_views": ["overview", "wan", "failover", "traffic", "diagnostics"],
  "secondary_views": ["system"]
}
